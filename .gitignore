# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Capacitor's synced Android web bundle (regenerated by `npx cap sync` from
# `dist`). Shouldn't live in git: it's a build artifact, not source, and
# every rebuild re-ships the anon key + query shape scanners flag as a
# "BaaS authority surface" — the DB-side RLS is what actually protects it,
# but there's no reason to also keep stale compiled JS in version control.
android/app/src/main/assets/public

# Android / Gradle build artifacts and machine-specific files
android/local.properties
android/.gradle
android/build
android/app/build
android/.idea
android/.kotlin
android/captures
android/*.iml
android/app/*.iml

# Android signing key — NEVER commit this. Losing it means you can't ship
# updates to the same Play Store listing ever again; leaking it means
# someone else could sign and publish updates as you. Keep it in a
# password manager / secure backup outside of git entirely.
*.jks
*.keystore

# Env files (Supabase URL/anon key — safe to be public in the bundle,
# but shouldn't live in git history as a matter of hygiene)
.env
.env.*
!.env.example

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

android.zip
